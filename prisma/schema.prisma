// GIZMORAC database schema.
// PostgreSQL (Neon) in production. `url` is the pooled connection used at
// runtime; `directUrl` is the unpooled connection used by Prisma CLI for
// `db push` / migrations (pgbouncer can't run those reliably).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id                String                 @id
  slug              String                 @unique
  name              String
  brand             String                 @default("GIZMORAC")
  sku               String
  // Amazon ASIN when imported from a Seller Central listings report (used to
  // match/update the same product on re-import). Null for manually-added items.
  asin              String?
  category          String
  art               String
  image             String?
  // JSON-encoded array of uploaded image URLs (up to 7). `image` mirrors images[0].
  images            String                 @default("[]")
  // Single uploaded product video URL (optional).
  video             String?
  price             Int
  mrp               Int
  // Purchase/landed cost per unit (whole rupees) — used for profit/COGS.
  cost              Int                    @default(0)
  // GST fields — ADMIN/INTERNAL ONLY. Never shown to customers or on receipts;
  // used for the P&L and GST filing export.
  hsn               String                 @default("")
  gstRate           Float                  @default(18)
  // Shipping package dimensions per unit (for Shiprocket rate/label).
  weightKg          Float                  @default(0.5)
  lengthCm          Int                    @default(15)
  breadthCm         Int                    @default(12)
  heightCm          Int                    @default(5)
  rating            Float                  @default(4.5)
  reviewCount       Int                    @default(0)
  stock             Int                    @default(0)
  // Inventory: warn/flag when stock falls to or below this threshold.
  lowStockThreshold Int                    @default(10)
  // Inventory ops: private staff note + reorder supplier (both optional).
  inventoryNote     String                 @default("")
  supplier          String                 @default("")
  // Manufacturer warranty length in months (0 = no warranty). Drives the
  // customer "Warranty claim" button, shown only while within this window.
  warrantyMonths    Int                    @default(0)
  shortDescription  String
  description       String
  // JSON-encoded arrays/objects (robust across SQLite/Prisma versions)
  badges            String                 @default("[]")
  highlights        String                 @default("[]")
  features          String                 @default("[]")
  specs             String                 @default("[]")
  faqs              String                 @default("[]")
  // JSON-encoded array of "what's in the box" item strings.
  inTheBox          String                 @default("[]")
  isBestSeller      Boolean                @default(false)
  isFeatured        Boolean                @default(false)
  isDeal            Boolean                @default(false)
  // false = Draft (hidden from the storefront). true = Active (live).
  active            Boolean                @default(true)
  // Post-order v2: money in integer paise (backfilled ×100 from rupee cols).
  pricePaise        Int?
  mrpPaise          Int?
  costPaise         Int?
  inventoryTxns     InventoryTransaction[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([category])
  @@index([active])
  @@index([asin])
}

model Order {
  id                     String             @id @default(cuid())
  orderNumber            String             @unique
  // Unguessable suffix for the public guest tracking link (GZ-123456-AB12CD34).
  trackingToken          String             @default("")
  // Pending|Confirmed|Packed|Shipped|Delivered|Cancelled|Returned|Refunded
  status                 String             @default("Pending")
  firstName              String
  lastName               String
  email                  String
  phone                  String
  address                String
  city                   String
  state                  String
  pincode                String
  // Optional buyer GSTIN for a business / input-tax-credit invoice.
  gstin                  String             @default("")
  // Registered company name — required when a GSTIN is supplied.
  companyName            String             @default("")
  items                  String             @default("[]") // JSON: [{ id, slug, name, price, qty }]
  subtotal               Int
  // `discount` = total of all discounts (coupon + instant offer).
  discount               Int                @default(0)
  // Instant promo-popup discount portion (browse/cart offer), part of `discount`.
  instantDiscount        Int                @default(0)
  // Which instant offer was claimed: "" | "browse" | "cart".
  instantOffer           String             @default("")
  shipping               Int                @default(0)
  total                  Int
  paymentMethod          String             @default("COD")
  // Online-payment status: "" (COD) | "Pending" | "Paid" | "Failed".
  paymentStatus          String             @default("")
  // Gateway reference (PhonePe transaction / UTR / order id) once paid.
  paymentRef             String             @default("")
  // Friendly instrument the customer paid with: "" | "UPI" | "Card" | "Netbanking" | "Wallet".
  paymentInstrument      String             @default("")
  // Failure reason shown on a failed online payment (for friendly retry).
  paymentError           String             @default("")
  // Refund tracking for online (PhonePe) refunds.
  refundStatus           String             @default("") // "" | "Initiated" | "Completed" | "Failed"
  refundAmount           Int                @default(0)
  refundRef              String             @default("") // merchant refund id
  // Shiprocket shipment tracking.
  shiprocketOrderId      String             @default("")
  shipmentId             String             @default("")
  awb                    String             @default("")
  courier                String             @default("")
  trackingUrl            String             @default("")
  labelUrl               String             @default("") // Shiprocket shipping-label PDF
  shipmentStatus         String             @default("") // latest Shiprocket status label
  shipmentCostPaise      Int                @default(0) // freight charged to us by Shiprocket (paise)
  // Replacement: reverse pickup (customer -> warehouse).
  returnOrderId          String             @default("")
  returnShipmentId       String             @default("")
  returnAwb              String             @default("")
  returnCourier          String             @default("")
  returnTrackingUrl      String             @default("")
  returnStatus           String             @default("") // "" until a replacement is started
  // Replacement: fresh forward shipment (warehouse -> customer).
  replacementOrderId     String             @default("")
  replacementShipmentId  String             @default("")
  replacementAwb         String             @default("")
  replacementCourier     String             @default("")
  replacementLabelUrl    String             @default("")
  replacementTrackingUrl String             @default("")
  replacementStatus      String             @default("")
  // Set when the order is marked Delivered — drives the 48h dispute window.
  deliveredAt            DateTime?
  couponCode             String?
  // Internal admin-only notes (never shown to the customer).
  adminNotes             String             @default("")
  // Optional link to a registered customer (guest checkout leaves this null).
  customerId             String?
  customer               Customer?          @relation(fields: [customerId], references: [id])
  // ───────── Post-order v2 (expand: backfilled, switched, then old cols dropped) ─────────
  version                Int                @default(0) // optimistic locking
  statusV2               OrderStatus? // canonical derived order status
  paymentState           PaymentStatus?
  refundState            RefundStatus?
  // Money in integer paise (nullable until ×100 backfill from the rupee columns).
  subtotalPaise          Int?
  discountPaise          Int?
  instantDiscountPaise   Int?
  shippingPaise          Int?
  totalPaise             Int?
  amountPaidPaise        Int?
  refundedPaise          Int?               @default(0)
  // ───────── COD Advance + RTO (additive; dark until codAdvanceEnabled) ─────────
  // Online booking amount charged at checkout for COD orders (paise). 0 = none.
  codAdvancePaise        Int                @default(0)
  // Balance collected at delivery = total − advance (paise).
  codRemainingPaise      Int                @default(0)
  // "" (prepaid/standard COD) | "PENDING" | "COLLECTED" | "FAILED".
  deliveryPaymentStatus  String             @default("")
  // Amount the courier actually collected on delivery (paise).
  deliveryCollectedPaise Int                @default(0)
  // "NONE" | "DELIVERY_FAILED" | "RTO_INITIATED" | "RTO_RECEIVED".
  rtoStatus              String             @default("NONE")
  // Item-level replacements spawn a new order row (ORD-..-R1).
  isReplacementOrder     Boolean            @default(false)
  replacesOrderId        String?
  replacesItemId         String?
  // Relations (post-order v2)
  orderItems             OrderItem[]
  disputes               Dispute[]
  refunds                Refund[]
  reversePickups         ReversePickup[]
  replacementsAsOriginal ReplacementOrder[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
  @@index([statusV2])
  @@index([email])
  @@index([customerId])
  @@index([createdAt])
  // COD/RTO dashboard filters (Phase 3 analytics).
  @@index([paymentMethod])
  @@index([rtoStatus])
}

model Customer {
  id             String               @id @default(cuid())
  fullName       String
  email          String               @unique
  phone          String               @default("")
  passwordHash   String
  address        String               @default("")
  city           String               @default("")
  state          String               @default("")
  pincode        String               @default("")
  // Marketing email opt-in (transactional mail is always sent).
  marketingOptIn Boolean              @default(true)
  // Soft delete: set when the customer deactivates their account. The row and
  // its orders are never removed — admin can restore by clearing this.
  deactivatedAt  DateTime?
  orders         Order[]
  addresses      Address[]
  // Post-order v2: fraud / abuse scoring (behind ffFraudScoring).
  riskProfile    CustomerRiskProfile?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

// Customer address book — multiple saved delivery addresses (ship-to-anywhere).
model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("") // optional nickname e.g. "Home", "Office"
  fullName   String
  phone      String
  line1      String
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  // "percent" | "fixed" | "bogo"
  type             String    @default("percent")
  value            Int       @default(0) // percent (0-100) or fixed ₹ amount
  minOrder         Int       @default(0) // minimum cart subtotal to qualify
  maxDiscount      Int       @default(0) // cap on % discount; 0 = no cap
  // Post-order v2: fixed-amount fields in integer paise (backfilled). Percent
  // (`type=percent`) stays in `value`; only fixed ₹ amounts convert.
  valuePaise       Int?
  minOrderPaise    Int?
  maxDiscountPaise Int?
  active           Boolean   @default(true)
  startsAt         DateTime?
  expiresAt        DateTime?
  usageLimit       Int       @default(0) // 0 = unlimited
  usedCount        Int       @default(0)
  description      String    @default("")
  // "manual" = created in admin; "reward" = auto-issued repeat-order coupon.
  kind             String    @default("manual")
  // For reward coupons: the order that earned it and the customer it belongs to.
  orderId          String?
  customerId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([customerId])
  @@index([orderId])
}

// A customer's rating + written feedback for one product on one delivered order.
model Review {
  id          String   @id @default(cuid())
  productId   String
  productSlug String
  orderId     String
  customerId  String?
  author      String
  location    String   @default("")
  rating      Int // 1..5
  title       String   @default("")
  body        String   @default("")
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // One review per product per order.
  @@unique([orderId, productId])
  @@index([productSlug])
  @@index([customerId])
}

// A damage/defect support request raised by a customer against an order.
model Ticket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  orderId      String
  orderNumber  String
  customerId   String?
  email        String
  name         String          @default("")
  // Damaged | Defective | Wrong item | Not working | Other
  category     String          @default("Damaged")
  description  String
  // Open | Awaiting proof | Under review | Resolved | Rejected
  status       String          @default("Open")
  // "" | Refund | Replacement | Warranty
  resolution   String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  messages     TicketMessage[]

  @@index([status])
  @@index([orderId])
  @@index([customerId])
  @@index([createdAt])
}

// One message in a ticket thread (customer or admin), with optional media proof.
model TicketMessage {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // "customer" | "admin"
  author       String
  body         String   @default("")
  // JSON-encoded array of uploaded image/video URLs.
  attachments  String   @default("[]")
  // true when an admin message is a request for photo/video proof.
  proofRequest Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer") // where they signed up: footer / home / …
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tagline   String   @default("")
  art       String   @default("printer") // fallback DeviceArt glyph
  image     String? // optional photo for the home grid
  sortOrder Int      @default(0)
  hidden    Boolean  @default(false) // hidden from the storefront (seasonal/coming-soon) without deleting
  featured  Boolean  @default(false) // promoted on the homepage
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// Single-row store configuration (id is always "store").
model StoreSetting {
  id                         String    @id @default("store")
  storeName                  String    @default("GIZMORAC")
  supportEmail               String    @default("")
  supportPhone               String    @default("")
  whatsappNumber             String    @default("919999999999")
  announcementText           String    @default("Free shipping over ₹999 · PAN India delivery · COD available")
  announcementEnabled        Boolean   @default(true)
  announcementScroll         Boolean   @default(false) // marquee (right→left) vs centered
  freeShippingThreshold      Int       @default(999)
  shippingFee                Int       @default(79)
  codEnabled                 Boolean   @default(true)
  // ───────── COD Advance Payment (additive; OFF = standard COD as today) ─────────
  codAdvanceEnabled          Boolean   @default(false) // master switch
  codAdvanceType             String    @default("FIXED") // "FIXED" | "PERCENT"
  codAdvanceAmount           Int       @default(200) // fixed booking amount (₹)
  codAdvancePercent          Int       @default(5) // % of order total (PERCENT mode)
  codAdvanceMax              Int       @default(300) // cap for PERCENT mode (₹)
  codAdvanceMin              Int       @default(0) // floor (₹); 0 = no floor
  // Registered company identity — editable in admin, shown across the
  // storefront (footer, policies) and on the GST tax invoice.
  legalName                  String    @default("BIG BAJAAR ECOM STOREE")
  companyAddress             String    @default("Plot No. 33, Block A, Mohan Cooperative Industrial Estate, New Delhi, Delhi - 110044, India")
  companyState               String    @default("Delhi") // for IGST vs CGST/SGST on invoices
  companyStateCode           String    @default("07") // GST state code (first 2 digits of GSTIN)
  companyPan                 String    @default("ABEFB8495P")
  companyGstin               String    @default("07ABEFB8495P1ZL")
  // Social media profile URLs (blank = icon hidden in the footer).
  instagramUrl               String    @default("")
  facebookUrl                String    @default("")
  youtubeUrl                 String    @default("")
  twitterUrl                 String    @default("")
  // Landing-page offer popup (feature 1) — admin-controlled.
  landingPopupEnabled        Boolean   @default(false)
  landingPopupTitle          String    @default("")
  landingPopupMessage        String    @default("")
  landingPopupCode           String    @default("")
  // Browsing nudge popup (feature 2) — flat instant discount, admin-controlled.
  browseOfferEnabled         Boolean   @default(false)
  browseOfferAmount          Int       @default(100)
  browseOfferDelay           Int       @default(25) // seconds of browsing before it shows
  // Cart-waiting popup (feature 3) — extra instant discount that stacks on coupons.
  cartOfferEnabled           Boolean   @default(false)
  cartOfferAmount            Int       @default(100)
  cartOfferDelay             Int       @default(60) // seconds items sit in cart before it shows
  // PhonePe payment gateway — admin-managed online payments (server-only secret).
  phonepeClientId            String    @default("")
  phonepeClientVersion       String    @default("1")
  phonepeClientSecret        String    @default("")
  phonepeEnv                 String    @default("sandbox") // "sandbox" | "production"
  phonepeConnected           Boolean   @default(false)
  // Shiprocket shipping — admin-managed (API user creds are server-only).
  shiprocketEmail            String    @default("")
  shiprocketPassword         String    @default("")
  shiprocketPickup           String    @default("") // pickup location nickname set in Shiprocket
  shiprocketPickupPin        String    @default("") // pickup pincode (for serviceability/ETA)
  shiprocketConnected        Boolean   @default(false)
  shiprocketToken            String    @default("") // cached auth token (server-only)
  shiprocketTokenExp         DateTime?
  // ───────── Post-order v2 ─────────
  // Master switch: when true, reads use the v2 (item-level) model. Default off
  // so the expand step is dark until backfill + verification pass.
  ffPostOrderV2              Boolean   @default(false)
  // Feature flags (advanced features stay off until staffed/configured).
  ffRbac                     Boolean   @default(false) // sub-users + role enforcement
  ffMakerChecker             Boolean   @default(false) // dual approval on high-value refunds
  ffFraudScoring             Boolean   @default(false)
  ffAutoQc                   Boolean   @default(true) // auto-pass QC while no QC staff exist
  ffNotifEmail               Boolean   @default(true) // email notifications (implemented first)
  ffNotifSms                 Boolean   @default(false)
  ffNotifWhatsapp            Boolean   @default(false)
  ffNotifPush                Boolean   @default(false)
  // Post-order config.
  returnWindowDays           Int       @default(7)
  maxAppeals                 Int       @default(1)
  investigationSlaHours      Int       @default(48)
  restockingFeePercent       Int       @default(0)
  highValueRefundPaise       Int       @default(500000) // ₹5,000 — above this needs manager approval
  // Finance: operating-cost assumptions for the P&L (editable on the Finance page).
  paymentFeePct              Float     @default(2) // payment-gateway MDR on online orders
  codFeePct                  Float     @default(0) // COD remittance fee, % of order value
  codFeeFlat                 Int       @default(0) // COD remittance fee, flat ₹ per COD order
  // Money in integer paise (backfilled ×100 from the rupee columns above).
  freeShippingThresholdPaise Int?
  shippingFeePaise           Int?
  browseOfferAmountPaise     Int?
  cartOfferAmountPaise       Int?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

// Per-pincode COD rules (additive; empty table = no effect = global behaviour).
model CodPincodeRule {
  id              String   @id @default(cuid())
  pincode         String   @unique
  // STANDARD | HIGHER_CHARGE | PREPAID_ONLY | COD_DISABLED
  mode            String   @default("STANDARD")
  // Booking advance (₹) override for HIGHER_CHARGE; null = use the global amount.
  advanceOverride Int?
  note            String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Activity + error log for support/debugging. Records customer & admin actions
// and captured server errors so issues can be traced and fixed.
model EventLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  level      String   @default("info") // info | warn | error
  actor      String   @default("system") // customer | admin | system
  actorId    String   @default("")
  actorEmail String   @default("")
  action     String // e.g. order.placed, admin.login, server.error
  message    String   @default("")
  meta       String   @default("") // JSON details
  ip         String   @default("")
  path       String   @default("")

  @@index([createdAt])
  @@index([level])
  @@index([actor])
  @@index([action])
}

// ════════════════════════════════════════════════════════════════════════════
// POST-ORDER ARCHITECTURE v2 — canonical (see docs/post-order-spec.md)
// EXPAND STEP: everything below is additive. Existing String/rupee columns are
// retained until the CONTRACT migration (Phase 7). Nothing here is dropped.
// ════════════════════════════════════════════════════════════════════════════

// ── Canonical enums (match the spec exactly) ───────────────────────────────
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
  RTO
  CLOSED
}

enum OrderItemStatus {
  ACTIVE
  RETURN_REQUESTED
  UNDER_INVESTIGATION
  PICKUP_SCHEDULED
  PICKED_UP
  QC_PENDING
  QC_PASSED
  QC_PARTIAL
  QC_FAILED
  REFUND_APPROVED
  REPLACEMENT_APPROVED
  REFUNDED
  REPLACED
  REJECTED
  CLOSED
}

enum DisputeStatus {
  NONE
  RAISED
  UNDER_INVESTIGATION
  ESCALATED
  REJECTED
  APPEALED
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  NOT_APPLICABLE
  PENDING
  PROCESSING
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  MANUAL_REVIEW
}

enum ReturnReason {
  CHANGE_OF_MIND
  SIZE_ISSUE
  DEFECTIVE_PRODUCT
  DAMAGED_PRODUCT
  WRONG_ITEM_RECEIVED
  DELIVERY_DAMAGE
  MISSING_ACCESSORIES
  QUALITY_ISSUE
}

// ── Supporting enums (operational tables) ──────────────────────────────────
enum QcResult {
  PENDING
  PASSED
  PARTIAL
  FAILED
}

enum PickupStatus {
  SCHEDULED
  PICKED_UP
  CANCELLED
  FAILED
}

enum ReplacementState {
  APPROVED
  CREATED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum RefundMethod {
  ORIGINAL
  MANUAL_UPI
  MANUAL_NEFT
  MANUAL_IMPS
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationState {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum InventoryTxnType {
  SALE
  RESTOCK_QC_PASS
  DAMAGE_QC_FAIL
  REPLACEMENT_DISPATCH
  RTO_RESTOCK
  CANCEL_RESTOCK
  MANUAL_ADJUST
}

enum RiskLevel {
  NORMAL
  ELEVATED
  STRICT_REVIEW
}

enum CreditNoteState {
  DRAFT
  ISSUED
  VOID
}

enum ActorRole {
  CUSTOMER
  SUPPORT
  OPERATIONS
  QC
  FINANCE
  MANAGER
  SYSTEM
  ADMIN
}

enum EntityType {
  ORDER
  ORDER_ITEM
  DISPUTE
  REFUND
  REPLACEMENT
}

// RBAC roles for sub-users (behind ffRbac; one OWNER holds all roles until then).
enum AdminRole {
  OWNER
  SUPPORT
  OPERATIONS
  QC
  FINANCE
  MANAGER
}

// ── order_items — the operational source of truth ──────────────────────────
model OrderItem {
  id                     String             @id @default(cuid())
  orderId                String
  order                  Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId              String? // null if the product was later deleted
  productSlug            String             @default("")
  name                   String
  sku                    String             @default("")
  hsn                    String             @default("")
  gstRate                Float              @default(18)
  qty                    Int
  // All money in integer paise.
  unitPricePaise         Int
  lineSubtotalPaise      Int // unitPricePaise * qty
  allocatedDiscountPaise Int                @default(0) // prorated order discount
  allocatedShippingPaise Int                @default(0) // prorated shipping
  netPaidPaise           Int // lineSubtotal - discount + shipping share (refund ceiling)
  status                 OrderItemStatus    @default(ACTIVE)
  returnReason           ReturnReason?
  version                Int                @default(0) // optimistic locking
  // Resolution bookkeeping
  refundedPaise          Int                @default(0)
  deductionPaise         Int                @default(0)
  deductionReason        String             @default("")
  resolvedAt             DateTime?
  closedAt               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  // Relations
  disputeItems           DisputeItem[]
  refunds                Refund[]
  qcReports              QcReport[]
  reversePickups         ReversePickup[]
  replacementLinks       ReplacementOrder[]

  @@index([orderId])
  @@index([status])
  @@index([productId])
}

// ── disputes — evidence / investigation / communication container ──────────
model Dispute {
  id             String           @id @default(cuid())
  disputeNumber  String           @unique
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id])
  customerId     String?
  email          String
  status         DisputeStatus    @default(RAISED)
  reason         ReturnReason?
  category       String           @default("") // legacy ticket category preserved
  description    String           @default("")
  appealsUsed    Int              @default(0)
  maxAppeals     Int              @default(1)
  slaDueAt       DateTime?
  escalatedAt    DateTime?
  version        Int              @default(0)
  legacyTicketId String? // backfill provenance: source Ticket.id
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  closedAt       DateTime?
  items          DisputeItem[]
  messages       DisputeMessage[]

  @@index([orderId])
  @@index([status])
  @@index([customerId])
}

model DisputeItem {
  id          String           @id @default(cuid())
  disputeId   String
  dispute     Dispute          @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id])
  outcome     OrderItemStatus? // REFUNDED | REPLACED | REJECTED | CLOSED once resolved
  createdAt   DateTime         @default(now())

  @@unique([disputeId, orderItemId])
  @@index([orderItemId])
}

// Dispute communication thread (successor to TicketMessage).
model DisputeMessage {
  id              String   @id @default(cuid())
  disputeId       String
  dispute         Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author          String // customer | admin | support | system
  body            String   @default("")
  attachments     String   @default("[]") // JSON urls
  proofRequest    Boolean  @default(false)
  legacyMessageId String?
  createdAt       DateTime @default(now())

  @@index([disputeId])
}

// ── refunds + gateway attempt log ──────────────────────────────────────────
model Refund {
  id               String              @id @default(cuid())
  orderId          String
  order            Order               @relation(fields: [orderId], references: [id])
  orderItemId      String? // null = order-level (full) refund
  orderItem        OrderItem?          @relation(fields: [orderItemId], references: [id])
  amountPaise      Int
  status           RefundStatus        @default(PENDING)
  method           RefundMethod        @default(ORIGINAL)
  reason           String              @default("")
  idempotencyKey   String              @unique
  refundReference  String              @default("") // our merchant refund id
  gatewayReference String              @default("") // PhonePe / UTR
  retryCount       Int                 @default(0)
  failureReason    String              @default("")
  creditNoteId     String?
  version          Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  completedAt      DateTime?
  transactions     RefundTransaction[]

  @@index([orderId])
  @@index([status])
  @@index([orderItemId])
}

model RefundTransaction {
  id               String       @id @default(cuid())
  refundId         String
  refund           Refund       @relation(fields: [refundId], references: [id], onDelete: Cascade)
  attempt          Int          @default(1)
  status           RefundStatus
  gatewayReference String       @default("")
  requestPayload   String       @default("") // JSON
  responsePayload  String       @default("") // JSON
  createdAt        DateTime     @default(now())

  @@index([refundId])
}

// ── replacement_orders — links an original item to its replacement order ───
model ReplacementOrder {
  id                 String           @id @default(cuid())
  originalOrderId    String
  originalOrder      Order            @relation(fields: [originalOrderId], references: [id])
  originalItemId     String
  originalItem       OrderItem        @relation(fields: [originalItemId], references: [id])
  replacementOrderId String? // Order.id of the new ORD-..-R1 (plain ref)
  state              ReplacementState @default(APPROVED)
  idempotencyKey     String           @unique
  deliveredAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([originalOrderId])
  @@index([originalItemId])
}

// ── reverse_pickups — idempotent return pickups ────────────────────────────
model ReversePickup {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  orderItemId     String?
  orderItem       OrderItem?   @relation(fields: [orderItemId], references: [id])
  provider        String       @default("shiprocket")
  providerOrderId String       @default("")
  shipmentId      String       @default("")
  awb             String       @default("")
  courier         String       @default("")
  trackingUrl     String       @default("")
  status          PickupStatus @default(SCHEDULED)
  idempotencyKey  String       @unique
  scheduledAt     DateTime?
  pickedUpAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orderId])
  @@index([orderItemId])
}

// ── qc_reports — warehouse inspection ──────────────────────────────────────
model QcReport {
  id             String    @id @default(cuid())
  orderItemId    String
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id])
  result         QcResult  @default(PENDING)
  conditionOk    Boolean   @default(false)
  serialOk       Boolean   @default(false)
  accessoriesOk  Boolean   @default(false)
  functionalOk   Boolean   @default(false)
  packagingOk    Boolean   @default(false)
  deductionPaise Int       @default(0)
  notes          String    @default("")
  photos         String    @default("[]") // JSON urls
  inspectedBy    String    @default("")
  createdAt      DateTime  @default(now())

  @@index([orderItemId])
}

// ── credit_notes — GST credit note for refunds against a tax invoice ───────
model CreditNote {
  id                String          @id @default(cuid())
  creditNoteNumber  String          @unique
  orderId           String
  refundId          String?
  invoiceNumber     String          @default("")
  amountPaise       Int
  taxableValuePaise Int             @default(0)
  cgstPaise         Int             @default(0)
  sgstPaise         Int             @default(0)
  igstPaise         Int             @default(0)
  state             CreditNoteState @default(DRAFT)
  pdfUrl            String          @default("")
  createdAt         DateTime        @default(now())

  @@index([orderId])
}

// ── notification_logs — multi-channel, retried (email first; rest flagged) ─
model NotificationLog {
  id         String              @id @default(cuid())
  orderId    String?
  customerId String?
  channel    NotificationChannel
  event      String // return_requested | pickup_scheduled | ...
  recipient  String
  subject    String              @default("")
  body       String              @default("")
  state      NotificationState   @default(PENDING)
  retryCount Int                 @default(0)
  error      String              @default("")
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  @@index([orderId])
  @@index([state])
  @@index([channel])
}

// ── customer_risk_profiles — fraud / abuse scoring (behind ffFraudScoring) ─
model CustomerRiskProfile {
  id           String    @id @default(cuid())
  customerId   String    @unique
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderCount   Int       @default(0)
  returnCount  Int       @default(0)
  disputeCount Int       @default(0)
  returnRate   Float     @default(0)
  fraudScore   Int       @default(0)
  level        RiskLevel @default(NORMAL)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ── inventory_transactions — authoritative, append-only ledger ─────────────
model InventoryTransaction {
  id             String           @id @default(cuid())
  productId      String
  product        Product          @relation(fields: [productId], references: [id])
  orderId        String?
  orderItemId    String?
  type           InventoryTxnType
  delta          Int // +n / -n
  stockAfter     Int
  reason         String           @default("")
  idempotencyKey String           @unique
  createdAt      DateTime         @default(now())

  @@index([productId])
  @@index([orderId])
}

// ── order_status_history — canonical per-transition audit (all entities) ───
// One row per transitionEntity() call across order/item/dispute/refund/
// replacement. Distinct from EventLog (generic app/error log). Never deleted.
model OrderStatusHistory {
  id            String     @id @default(cuid())
  entityType    EntityType
  entityId      String
  orderId       String? // owning order when known (convenience index)
  previousState String     @default("")
  newState      String
  actorRole     ActorRole  @default(SYSTEM)
  actorId       String     @default("")
  actorEmail    String     @default("")
  reason        String     @default("")
  metadata      String     @default("") // JSON
  ip            String     @default("")
  createdAt     DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([orderId])
  @@index([createdAt])
}

// ── webhook event ledger (§11) — dedup + out-of-order protection ───────────
model WebhookEvent {
  id               String    @id @default(cuid())
  provider         String // phonepe | shiprocket
  eventId          String
  signature        String    @default("")
  gatewayReference String    @default("")
  payload          String    @default("") // JSON
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([gatewayReference])
}

// ── RBAC sub-users (behind ffRbac; OWNER holds all roles until enabled) ────
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("")
  passwordHash String    @default("")
  role         AdminRole @default(OWNER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Anonymous live-presence heartbeat. One row per active browser tab, keyed by a
// random client-generated token (no cookie, no IP, no PII). Rows are upserted on
// each ping and pruned once stale; the admin "online now" count is the number of
// rows seen within the active window.
model LiveVisitor {
  id       String   @id
  path     String   @default("")
  lastSeen DateTime @default(now())

  @@index([lastSeen])
}
