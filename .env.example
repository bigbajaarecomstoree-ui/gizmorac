# ============================================================================
# GIZMORAC — environment variables
# Copy to .env for local dev. In production (Vercel), set these in
# Project → Settings → Environment Variables. Never commit real secrets.
# ============================================================================

# --- Database ---
# Local dev uses SQLite (zero setup):
DATABASE_URL="file:./dev.db"
# Production: a hosted PostgreSQL connection string, e.g. Neon / Supabase / Vercel Postgres.
# (Also switch prisma/schema.prisma datasource `provider` to "postgresql".)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- Admin panel auth ---
# Use a strong, unique password in production.
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Secret used to sign admin + customer session JWTs. Keep private; rotate for prod.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="generate-a-long-random-string-see-command-above"

# --- Public site URL (canonical / OG / sitemap) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3007"
# Production: NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- Media uploads (production only) ---
# When set, product/category image uploads go to Vercel Blob (persistent).
# Vercel: create a Blob store → it auto-injects this token. Leave blank for local dev
# (uploads fall back to /public/uploads).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- Cron auth (production) ---
# Protects /api/cron/* so only Vercel Cron can trigger it. Set this in Vercel and
# Vercel automatically sends it as `Authorization: Bearer <CRON_SECRET>`.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET="generate-a-long-random-string"

# --- Rate limiting (production) ---
# When both are set, login/signup/coupon/newsletter are rate-limited by IP via
# Upstash Redis (REST). Leave blank to disable (limiter becomes a no-op).
# Create a free DB at upstash.com → copy the REST URL + token.
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxxxx"

# --- Payment safety ---
# In production a sandbox PhonePe gateway is refused (so a customer can't be sent
# through a fake-money flow). Set to "true" only for an intentional prod dry-run.
# ALLOW_SANDBOX_IN_PROD="false"

# --- Analytics (public; client-readable) ---
# GA4 measurement ID + Meta Pixel ID. Each loads only when its value is set;
# leave blank to disable. Events: page_view, view_item, add_to_cart,
# begin_checkout, purchase (with order value + items).
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_META_PIXEL_ID="000000000000000"
