# ============================================================================
# GIZMORAC — environment variables
# Copy to .env for local dev. In production (Vercel), set these in
# Project → Settings → Environment Variables. Never commit real secrets.
# ============================================================================

# --- Database ---
# Local dev uses SQLite (zero setup):
DATABASE_URL="file:./dev.db"
# Production: a hosted PostgreSQL connection string, e.g. Neon / Supabase / Vercel Postgres.
# (Also switch prisma/schema.prisma datasource `provider` to "postgresql".)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- Admin panel auth ---
# Use a strong, unique password in production.
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Secret used to sign admin + customer session JWTs. Keep private; rotate for prod.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="generate-a-long-random-string-see-command-above"

# --- Public site URL (canonical / OG / sitemap) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3007"
# Production: NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- Media uploads (production only) ---
# When set, product/category image uploads go to Vercel Blob (persistent).
# Vercel: create a Blob store → it auto-injects this token. Leave blank for local dev
# (uploads fall back to /public/uploads).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
